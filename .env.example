ENVIRONMENT=development
DATABASE_URL=postgresql://evidencedesk:local-development-only@127.0.0.1:54329/evidencedesk
MIGRATION_DATABASE_URL=postgresql://evidencedesk:local-development-only@127.0.0.1:54329/evidencedesk
# Generate matching API and BFF values with: openssl rand -hex 32
SERVICE_KEY=
API_ORIGIN=http://127.0.0.1:8000
# Server-only access to the protected API preview, distinct from the web project's bypass.
API_PROTECTION_BYPASS_SECRET=
APP_ORIGIN=http://localhost:3000
AI_MODE=simulated
AI_ENABLED=true
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Generation provider: cloudflare (free default), openai (hosted GPT-6 Luna, paid per token),
# or openai_compatible (a self-hosted server, for example `llama-server` serving the fine-tuned
# Gemma GGUF; see ml/README.md). Embeddings stay on Cloudflare. Cloudflare remains the
# fallback when GENERATION_FALLBACK=true.
# For openai: set GENERATION_PROVIDER=openai and store the key with
# `python3 scripts/enter-openai-key.py`; leave GENERATION_BASE_URL and GENERATION_MODEL empty
# to use https://api.openai.com/v1 and gpt-6-luna. Put a hard spend limit on the OpenAI project.
GENERATION_PROVIDER=cloudflare
GENERATION_BASE_URL=http://127.0.0.1:8080/v1
GENERATION_MODEL=evidencedesk-gemma-4-12b
GENERATION_API_KEY=
GENERATION_TIMEOUT_SECONDS=30
GENERATION_JSON_SCHEMA=true
GENERATION_DISABLE_THINKING=true
GENERATION_FALLBACK=true
# One-hop document graph expansion after rank fusion (see reports/graph-expansion.md).
GRAPH_EXPANSION=false
# Raise for slower self-hosted models; the web BFF timeout must stay above this value.
ANALYSIS_DEADLINE_SECONDS=40
