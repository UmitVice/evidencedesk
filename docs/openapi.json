  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "title": "Question",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "AnalyzeRequest"
      },
      "Answer": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "answered",
              "insufficient_evidence"
            ],
            "title": "Status"
          },
          "claims": {
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "type": "array",
            "maxItems": 4,
            "title": "Claims"
          },
          "proposed_note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1200,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Proposed Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "claims"
        ],
        "title": "Answer"
      },
      "AuditResponse": {
        "properties": {
          "event": {
            "type": "string",
            "title": "Event"
          },
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "title": "Proposal Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "event",
          "proposal_id",
          "created_at"
        ],
        "title": "AuditResponse"
      },
      "Citation": {
        "properties": {
          "source_id": {
            "type": "string",
            "maxLength": 36,
            "minLength": 36,
            "title": "Source Id"
          },
          "quote": {
            "type": "string",
            "maxLength": 400,
            "minLength": 10,
            "title": "Quote"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "quote"
        ],
        "title": "Citation"
      },
      "Claim": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 600,
            "minLength": 1,
            "title": "Text"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Citations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "citations"
        ],
        "title": "Claim"
      },
      "DecisionRequest": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision"
        ],
        "title": "DecisionRequest"
      },
      "DecisionResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "applied",
              "rejected"
            ],
            "title": "Status"
          },
          "note_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note Id"
          },
          "replayed": {
            "type": "boolean",
            "title": "Replayed"
          }
        },
        "type": "object",
        "required": [
          "status",
          "note_id",
          "replayed"
        ],
        "title": "DecisionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NoteResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "content",
          "created_at"
        ],
        "title": "NoteResponse"
      },
      "ProposalResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "content_hash": {
            "type": "string",
            "title": "Content Hash"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "applied",
              "rejected"
            ],
            "title": "Status"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "expected_version": {
            "type": "integer",
            "title": "Expected Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "content",
          "content_hash",
          "status",
          "expires_at",
          "expected_version"
        ],
        "title": "ProposalResponse"
      },
      "RunResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "ticket_id": {
            "type": "string",
            "format": "uuid",
            "title": "Ticket Id"
          },
          "ticket_version": {
            "type": "integer",
            "title": "Ticket Version"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "complete",
              "failed"
            ],
            "title": "Status"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulated",
              "live"
            ],
            "title": "Mode"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Answer"
              },
              {
                "type": "null"
              }
            ]
          },
          "proposal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ProposalResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/SourceResponse"
            },
            "type": "array",
            "title": "Evidence"
          },
          "trace": {
            "additionalProperties": true,
            "type": "object",
            "title": "Trace"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "ticket_id",
          "ticket_version",
          "status",
          "mode",
          "result",
          "proposal",
          "evidence",
          "trace",
          "error_code",
          "created_at"
        ],
        "title": "RunResponse"
      },
      "RunSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "mode",
          "created_at"
        ],
        "title": "RunSummary"
      },
      "SessionResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulated",
              "live"
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "token",
          "expires_at",
          "mode"
        ],
        "title": "SessionResponse"
      },
      "SourceResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "heading": {
            "type": "string",
            "title": "Heading"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "active"
          }
        },
        "type": "object",
        "required": [
          "id",
          "heading",
          "body",
          "title",
          "source_id",
          "version"
        ],
        "title": "SourceResponse"
      },
      "TicketResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "sample": {
            "type": "string",
            "title": "Sample"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "notes": {
            "items": {
              "$ref": "#/components/schemas/NoteResponse"
            },
            "type": "array",
            "title": "Notes"
          },
          "audit": {
            "items": {
              "$ref": "#/components/schemas/AuditResponse"
            },
            "type": "array",
            "title": "Audit"
          },
          "runs": {
            "items": {
              "$ref": "#/components/schemas/RunSummary"
            },
            "type": "array",
            "title": "Runs"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sample",
          "title",
          "body",
          "version",
          "notes",
          "audit",
          "runs"
        ],
        "title": "TicketResponse"
      },
      "TicketSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "sample": {
            "type": "string",
            "title": "Sample"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "sample",
          "title",
          "body",
          "version"
        ],
        "title": "TicketSummary"
      },
      "TicketsResponse": {
        "properties": {
          "tickets": {
            "items": {
              "$ref": "#/components/schemas/TicketSummary"
            },
            "type": "array",
            "title": "Tickets"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simulated",
              "live"
            ],
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "tickets",
          "mode"
        ],
        "title": "TicketsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
